{
	"schemaVersion": 1,
	"id": "askgemini",
	"version": "${version}",
	"name": "AskGemini",
	"description": "A Minecraft mod that integrates Google Gemini AI directly into the in-game chat.",
	"authors": [
		"Luks_X_A"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/askgemini",
		"sources": "https://github.com/Lucas-X-A/AskGemini_Minecraft_Mod",
		"issues": "https://github.com/Lucas-X-A/AskGemini_Minecraft_Mod/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/askgemini/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"br.com.lucasxa.askgemini.AskGemini"
		],
		"client": [
			"br.com.lucasxa.askgemini.AskGeminiClient"
		]
	},
	"mixins": [
		"askgemini.mixins.json",
		{
			"config": "askgemini.client.mixins.json",
			"environment": "client"
		}
